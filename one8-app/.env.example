# Get this from your Neon project dashboard: Connection Details -> Connection string
# It should look like: postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xxxxxxx.neon.tech/neondb?sslmode=require

# Port the local server runs on
PORT=3000

# Secret key required in the "x-admin-key" header to view/manage reservations & add menu items
ADMIN_KEY=change-this-to-a-long-random-secret
